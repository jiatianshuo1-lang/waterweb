# ====== Django 生产环境 ======
DJANGO_ENV=production
DJANGO_SECRET_KEY=please-change-this-to-a-long-random-string-at-least-50-chars

# ====== PostgreSQL ======
DB_NAME=waterweb
DB_USER=postgres
DB_PASSWORD=please-change-db-password
DB_HOST=postgres
DB_PORT=5432

# ====== Redis ======
REDIS_URL=redis://redis:6379/1

# ====== 域名与安全 ======
# 若用云服务器公网IP直接访问，填 "*"；若绑域名，填域名如 waterweb.yourdomain.com
ALLOWED_HOSTS=*
CORS_ALLOW_ALL=False
# 前端域名/IP，多个用逗号分隔
CORS_ALLOWED_ORIGINS=http://your-server-ip,https://waterweb.yourdomain.com
FORCE_HTTPS=False

# ====== 超级管理员初始化（首次启动自动创建） ======
ADMIN_USERNAME=admin
ADMIN_PASSWORD=please-change-admin-password
ADMIN_EMAIL=admin@yourdomain.com
