DJANGO_ENV=development
DJANGO_SECRET_KEY=change-me-in-production-waterweb-2026
DB_NAME=waterweb
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
REDIS_URL=redis://localhost:6379/1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost
ALLOWED_HOSTS=*
FORCE_HTTPS=False
SECURE_HSTS_SECONDS=0
# RAG/MinerU（扫描型 PDF、拍照件需要单独部署 MinerU API）
MINERU_API_URL=http://mineru:8000
# 服务器建议设为 /opt/waterweb/data/knowledge；容器内固定挂载为 /data/knowledge（只读）
KNOWLEDGE_SOURCE_DIR=./data/knowledge
